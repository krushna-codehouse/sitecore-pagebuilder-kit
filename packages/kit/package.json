{
  "name": "sitecore-pagebuilder-kit",
  "version": "0.1.0",
  "description": "Page Builder-safe rendering helpers for Sitecore Content SDK: field guards, field-type empty checks, editor-only hints and editing-aware hooks.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@sitecore-content-sdk/react": ">=1.0.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "@sitecore-content-sdk/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sitecore-content-sdk/react": "^2.5.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "keywords": [
    "sitecore",
    "content-sdk",
    "page-builder",
    "sitecoreai",
    "xm-cloud",
    "nextjs",
    "react"
  ],
  "author": "Krushna Patel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Krushna285/sitecore-pagebuilder-kit.git",
    "directory": "packages/kit"
  },
  "homepage": "https://github.com/Krushna285/sitecore-pagebuilder-kit/tree/main/packages/kit#readme",
  "bugs": {
    "url": "https://github.com/Krushna285/sitecore-pagebuilder-kit/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
